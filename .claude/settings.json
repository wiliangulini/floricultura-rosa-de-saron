{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 14,
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",

      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test)"
    ],
    "deny": [
      "Read(/.claude/settings.local.json)",
      "Edit(/.claude/settings.local.json)",

      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/.env.development)",
      "Read(/.env.production)",
      "Read(/.env.test)",
      "Read(/.env.*.local)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Read(/secrets/**)",
      "Read(/**/secrets/**)",
      "Read(/**/credentials.json)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",

      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/.env.development)",
      "Edit(/.env.production)",
      "Edit(/.env.test)",
      "Edit(/.env.*.local)",
      "Edit(/**/.env)",
      "Edit(/secrets/**)",
      "Edit(/**/secrets/**)",
      "Edit(/**/credentials.json)",
      "Edit(/**/*.pem)",
      "Edit(/**/*.key)",

      "Bash(rm *)",
      "Bash(rmdir *)",

      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git push)",
      "Bash(git push *)",

      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",

      "Bash(docker *)",
      "Bash(docker-compose *)",

      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(mysql *)",
      "Bash(mongosh *)",
      "Bash(redis-cli *)",

      "Bash(printenv *)",
      "Bash(env)",
      "Bash(env *)",

      "Bash(node -e *)",
      "Bash(node --eval*)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",

      "Bash(chmod 777 *)",
      "Bash(chown *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(truncate *)",

      "Bash(*deploy-to-vps.sh*)",
      "Bash(vercel*)",
      "Bash(*npm run deploy*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",

      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npx *)",

      "Bash(npm run test:e2e)",
      "Bash(npm run test:e2e:ui)",
      "Bash(npm run test:e2e:headed)",

      "Bash(npm run db:generate)",
      "Bash(npm run db:migrate:dev)",
      "Bash(npm run db:migrate:deploy)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:studio)",
      "Bash(npm run db:seed:e2e)",
      "Bash(npm run db:setup:e2e)",
      "Bash(npm run db:update:categories:apply)",
      "Bash(npm run db:import:products:apply)",
      "Bash(npm run db:update:store-location:apply)",
      "Bash(npm run db:remove:legacy-products:apply)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/.next/**/CLAUDE.md",
    "**/dist/**/CLAUDE.md",
    "**/build/**/CLAUDE.md",
    "**/coverage/**/CLAUDE.md"
  ],
  "autoCompactEnabled": true,
  "enabledPlugins": {
    "drydocs@cardio": false
  }
}
